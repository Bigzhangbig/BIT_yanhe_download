/* BIT 延河课堂 Textual TUI 样式 — 美化界面 */

Screen {
    background: $surface;
}

#title {
    content-align: center middle;
    text-style: bold;
    color: $accent;
    height: 3;
    padding: 1 0;
}

#subtitle {
    content-align: center middle;
    color: $text-muted;
    height: 1;
    padding: 0 0 1 0;
}

#status {
    dock: bottom;
    height: 1;
    color: $text-muted;
    background: $boost;
    padding: 0 1;
}

#stage {
    padding: 1 2;
    height: 1fr;
}

Vertical {
    height: auto;
}

Label {
    height: 1;
    margin: 1 0 0 0;
    color: $secondary;
    text-style: bold;
}

Input {
    margin: 0 0 1 0;
}

SelectionList {
    height: 1fr;
    min-height: 6;
    margin: 0 0 1 0;
    border: round $primary;
}

OptionList {
    height: 1fr;
    min-height: 6;
    margin: 0 0 1 0;
    border: round $primary;
}

Select {
    margin: 0 0 1 0;
}

#button-row {
    height: 3;
    align-horizontal: center;
    margin: 1 0 0 0;
}

#button-row > Button {
    margin: 0 1;
}

#msg {
    color: $warning;
    text-style: bold;
    height: 1;
    margin: 0 0 1 0;
}

#info {
    color: $text-muted;
    height: auto;
    margin: 0 0 1 0;
}

.footer-hint {
    color: $text-muted;
}
